# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
!.env.example

# Data — raw USGS release is public (CC0) but large; re-download via docs/DATA.md
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained artifacts (bundled into the backend Docker image at build time, not tracked)
models/*
!models/.gitkeep
!models/README.md

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
