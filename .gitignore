# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Coverage output (binary database and reports)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment / secrets
.env
.env.*
!.env.example

# Data — raw USGS release is public (CC0) but 1.4 GB; re-download via docs/DATA.md.
# data/processed/ (≈3 MB) and models/ (≈2 MB) ARE tracked so the API deploys from GitHub
# and the evaluation scripts run without the raw release.
data/raw/*
!data/raw/.gitkeep

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Live extraction cache (regenerated on demand; warm with scripts/warm_live_cache.py)
data/live_cache/

# Location baselines built from the satellite archive (rebuild via /live/baseline)
data/baseline_cache/

# Per-target intermediate results; docs/results/benchmarks.md is the deliverable
docs/results/benchmarks_partial/

# Renderings of results that are committed in machine-readable form — regenerate with the
# evaluation scripts. xgb_baseline.json is NOT ignored: /validation serves the dashboard from it,
# and xgb_baseline.md is only that same data as a table.
docs/results/benchmarks.json
docs/results/uncertainty.json
docs/results/xgb_baseline.md

# Generated by scripts/preprocess.py; the same figures are in docs/data_findings.md and the
# machine-readable audit lives in data/processed/preprocess_audit.json
docs/preprocess_summary.md
